DB_URL=
DB_USER=
DB_PASSWORD=
KAKAO_CLIENT_ID=
KAKAO_SECRET=
GRANT_TYPE=
NAVER_CLIENT_ID=
NAVER_SECRET=
REDIRECT_URI=
REDIS_HOST=
REDIS_PORT=
APP_FRONT_URL=
KWAKAI_BASE_URL=
JWT_SECRET=
FINNHUB_API_KEY=
REDIS_PASSWORD=
# api-gateway -> core(portal) 주소 (SP1 병합으로 단일 목적지)
CORE_URI=http://localhost:8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- SP2: ai-app 추출(service:ai, :8090) ---
# core(portal) -> ai-app 게이트웨이 base url
AI_URI=http://localhost:8090
# core <-> ai-app 내부 시스템 인증 키 (X-System-Key)
SYSTEM_API_KEY=
# ai-app: kwakai 로컬 LLM (모든 추론이 여기로 간다)
KWAKAI_MODEL=gemma4-31b
# 이미지 추론용 모델. 비우면 KWAKAI_MODEL 을 그대로 쓴다.
# 매매내역 화면 캡처를 읽히려면 멀티모달 모델이어야 한다.
KWAKAI_VISION_MODEL=
# 이미지 추론 타임아웃(초). 로컬 GPU는 텍스트보다 훨씬 오래 걸린다.
KWAKAI_VISION_TIMEOUT=300
# vLLM이 response_format(guided decoding)을 지원하면 true 권장
KWAKAI_JSON_MODE=false

# --- 매매기록 추출 경로 ---
# true 면 n8n 의 trade-extract 워크플로우를 태운다 (실패 시 ai 모듈로 자동 폴백).
# 워크플로우가 실제로 도는 걸 확인한 뒤에 켤 것.
TRADE_EXTRACTION_VIA_N8N=false
TRADE_EXTRACTION_N8N_URL=http://localhost:5678/webhook/trade-extract
TRADE_EXTRACTION_N8N_TIMEOUT=360

# --- n8n (docker-compose.n8n.yml) ---
# credential 암호화 키. 반드시 고정·백업 (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# n8n -> collector 내부 API 주소 (같은 compose 네트워크면 http://api:8000)
COLLECTOR_URI=http://host.docker.internal:8000
# FRED 거시지표 수집 (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
FRED_START_DATE=2015-01-01
