        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "원문 요청",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 원문 HTML에서 본문 텍스트를 뽑고 상태를 판정한다.\n// 상태값 규약은 collector/news_crawler/content_store.py 와 맞춰야 한다.\nconst src = $('기사별 처리').item.json;\nconst res = $json;\n\nconst MIN_CHARS = 400;\nlet status = 'FAILED';\nlet content = null;\n\nconst statusCode = Number(res.statusCode ?? 0);\nconst html = typeof res.body === 'string' ? res.body : '';\n\nif (res.error) {\n  // 타임아웃·DNS 실패 등 — 재시도 대상\n  status = 'FAILED';\n} else if (statusCode === 403 || statusCode === 401 || statusCode === 404 || statusCode === 410) {\n  // 봇 차단·페이월·삭제된 기사 — 다시 시도해도 같다\n  status = 'BLOCKED';\n} else if (statusCode >= 400 || !html) {\n  status = 'FAILED';\n} else {\n  let text = html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n    .replace(/<!--[\\s\\S]*?-->/g, ' ');\n\n  // <article> 이 있으면 그 안쪽만 — 네비게이션·추천기사 같은 잡음을 줄인다\n  const article = text.match(/<article[\\s\\S]*?<\\/article>/i);\n  if (article) text = article[0];\n\n  text = text\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&quot;/gi, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  content = text;\n  status = text.length >= MIN_CHARS ? 'OK' : 'EMPTY';\n}\n\nreturn {\n  json: {\n    articleId: src.id,\n    status,\n    content,\n    resolvedUrl: src.url,\n  },\n};\n"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "본문 추출",
